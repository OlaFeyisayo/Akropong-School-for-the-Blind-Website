---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localizedPath, defaultLang } from '../i18n/utils';
const lang = defaultLang;
const t = useTranslations(lang);
---
<BaseLayout lang={lang} title={t('notFound.title')}>
  <section class="section">
    <div class="container center stack" style="max-width: 40rem; margin-inline: auto;">
      <p class="eyebrow">404</p>
      <h1>{t('notFound.title')}</h1>
      <p class="lead">{t('notFound.text')}</p>
      <p><a href={localizedPath(lang, '')} class="btn btn-primary">{t('notFound.home')}</a></p>
    </div>
  </section>
</BaseLayout>

---
import '../styles/global.css';
import settings from '../data/settings.json';
---

<!doctype html>
<html lang="en" data-theme="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{settings.orgName}</title>
    <meta name="description" content={settings.tagline_en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('a11y-theme');
          if (t) document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <main id="main" class="splash">
      <div class="splash-card">
        <span class="splash-mark" aria-hidden="true">⠁</span>
        <h1>{settings.orgName}</h1>
        <p class="splash-tag">{settings.tagline_en}</p>
        <p class="splash-tag fr">{settings.tagline_fr}</p>
        <nav aria-label="Choose language / Choisir la langue" class="splash-actions">
          <a href="/en/" class="btn btn-primary" lang="en">English</a>
          <a href="/fr/" class="btn btn-accent" lang="fr">Français</a>
        </nav>
      </div>
    </main>

    <style>
      .splash {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, var(--brand) 0%, var(--brand-darker) 100%);
      }
      .splash-card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        padding: clamp(2rem, 6vw, 3.5rem);
        max-width: 34rem;
        text-align: center;
      }
      .splash-mark {
        display: inline-flex; align-items: center; justify-content: center;
        width: 72px; height: 72px; margin-bottom: 1rem;
        background: var(--brand); color: #fff; border-radius: 18px; font-size: 2.6rem; line-height: 1;
      }
      .splash-tag { color: var(--ink-soft); margin-top: 0.5rem; margin-inline: auto; }
      .splash-tag.fr { color: var(--muted); font-style: italic; }
      .splash-actions { display: flex; gap: 0.8rem; justify-content: center; margin-top: 1.75rem; flex-wrap: wrap; }
    </style>
  </body>
</html>

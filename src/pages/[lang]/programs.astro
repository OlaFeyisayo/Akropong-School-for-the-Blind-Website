---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath, loc, toLang, type Lang } from '../../i18n/utils';
import programs from '../../data/pages/programs.json';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}
const lang: Lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={loc(programs, 'title', lang)}>
  <PageHeader title={loc(programs, 'title', lang)} intro={loc(programs, 'intro', lang)} />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {programs.programs?.map((p) => (
          <article class="card feature">
            <div class="card-body">
              <span class="feature-icon" aria-hidden="true"><Icon name={p.icon} size={30} /></span>
              <h2 class="prog-title">{loc(p, 'title', lang)}</h2>
              <p>{loc(p, 'text', lang)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <h2>{lang === 'fr' ? 'Aidez-nous à soutenir ces programmes' : 'Help us sustain these programs'}</h2>
      <a href={localizedPath(lang, 'donate')} class="btn btn-accent">
        <Icon name="heart" size={20} /> {t('btn.donateNow')}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-icon { display: inline-grid; place-items: center; width: 56px; height: 56px; border-radius: 14px; background: var(--surface-2); color: var(--brand-dark); margin-bottom: 0.3rem; }
  .prog-title { font-size: 1.3rem; }
  .cta-band { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-darker) 100%); color: #fff; padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  :global([data-contrast="high"]) .cta-band { background: #000; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .cta-inner h2 { color: #fff; max-width: 30ch; }
</style>

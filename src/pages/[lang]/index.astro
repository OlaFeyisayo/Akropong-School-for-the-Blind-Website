---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath, loc, formatDate, toLang, type Lang } from '../../i18n/utils';
import { getAllNews } from '../../lib/news';
import home from '../../data/pages/home.json';
import about from '../../data/pages/about.json';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang: Lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const news = getAllNews().slice(0, 3);
const statIcons = ['book', 'heart', 'eye'];
---

<BaseLayout lang={lang} title={t('nav.home')}>
  <!-- Hero: dark panel + photo (reference-style) -->
  <section class="hero">
    <div class="container">
      <div class="hero-panel">
        <div class="hero-text">
          <p class="eyebrow light">Akropong School for the Blind · Ghana</p>
          <h1>{loc(home, 'heroTitle', lang)}</h1>
          <p class="hero-sub">{loc(home, 'heroSubtitle', lang)}</p>
          <div class="hero-actions">
            <a href={localizedPath(lang, 'donate')} class="btn btn-white">
              <Icon name="heart" size={20} /> {t('btn.donateNow')}
            </a>
            <a href={localizedPath(lang, 'admissions')} class="btn btn-ghost-light">{t('nav.admissions')}</a>
          </div>
        </div>
        <div class="hero-photo">
          {home.heroImage
            ? <img src={home.heroImage} alt={loc(home, 'heroImageAlt', lang)} width="560" height="620" />
            : (
              <div class="hero-ph" aria-hidden="true">
                <span class="braille braille-lg"><i></i><i class="off"></i><i></i><i></i><i class="off"></i><i></i></span>
                <Icon name="eye" size={56} />
              </div>
            )}
        </div>
      </div>

      <!-- Overlapping stat cards -->
      {home.stats?.length > 0 && (
        <dl class="stat-cards">
          {home.stats.map((s, i) => (
            <div class="stat-card">
              <span class="stat-icon" aria-hidden="true"><Icon name={statIcons[i % statIcons.length]} size={24} /></span>
              <div>
                <dd>{s.value}</dd>
                <dt>{loc(s, 'label', lang)}</dt>
              </div>
            </div>
          ))}
        </dl>
      )}
    </div>
  </section>

  <!-- About (reference-style: collage + copy + vision/mission) -->
  <section class="section about-home">
    <div class="container about-grid">
      <div class="about-photos" aria-hidden={about.heroImage ? undefined : 'true'}>
        {about.heroImage
          ? <img class="about-img-main" src={about.heroImage} alt={loc(about, 'heroImageAlt', lang)} width="520" height="620" />
          : <div class="about-ph about-ph-main"><span class="braille"><i></i><i class="off"></i><i></i><i></i><i></i><i class="off"></i></span></div>}
        {home.ctaImage
          ? <img class="about-img-sub" src={home.ctaImage} alt={loc(home, 'ctaImageAlt', lang)} width="300" height="320" />
          : <div class="about-ph about-ph-sub"><Icon name="book" size={40} /></div>}
      </div>

      <div class="about-copy stack">
        <p class="eyebrow">{t('nav.about')}</p>
        <h2>{loc(home, 'introTitle', lang)}</h2>
        <p class="lead">{loc(about, 'intro', lang)}</p>
        <div class="vm-grid">
          <div class="vm">
            <h3>{loc(about, 'visionTitle', lang)}</h3>
            <p>{loc(about, 'visionBody', lang)}</p>
          </div>
          <div class="vm">
            <h3>{loc(about, 'missionTitle', lang)}</h3>
            <p>{loc(about, 'missionBody', lang)}</p>
          </div>
        </div>
        <p><a href={localizedPath(lang, 'about')} class="link-arrow">{t('btn.learnMore')} <Icon name="arrow" size={18} /></a></p>
      </div>
    </div>
  </section>

  <!-- What we offer -->
  <section class="section soft">
    <div class="container">
      <div class="center stack" style="max-width: 46rem; margin-inline: auto;">
        <p class="eyebrow">{loc(home, 'introEyebrow', lang)}</p>
        <h2>{loc(home, 'highlightsTitle', lang)}</h2>
      </div>
      <div class="grid grid-3" style="margin-top: 3rem;">
        {home.highlights?.map((h) => (
          <article class="card feature">
            <div class="card-body">
              <span class="feature-icon" aria-hidden="true"><Icon name={h.icon} size={28} /></span>
              <h3>{loc(h, 'title', lang)}</h3>
              <p>{loc(h, 'text', lang)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Donate CTA band -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="stack">
        <h2>{loc(home, 'ctaTitle', lang)}</h2>
        <p class="lead cta-text">{loc(home, 'ctaText', lang)}</p>
      </div>
      <a href={localizedPath(lang, 'donate')} class="btn cta-btn">
        <Icon name="gift" size={20} /> {t('btn.donateNow')}
      </a>
    </div>
  </section>

  <!-- Latest news -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('nav.news')}</p>
          <h2>{t('home.latestNews')}</h2>
        </div>
        <a href={localizedPath(lang, 'news')} class="link-arrow">{t('btn.allNews')} <Icon name="arrow" size={18} /></a>
      </div>
      {news.length > 0 ? (
        <div class="grid grid-3" style="margin-top: 2.5rem;">
          {news.map((n) => (
            <article class="card">
              {n.data.image
                ? <img src={n.data.image} alt={loc(n.data, 'imageAlt', lang)} width="400" height="250" />
                : <div class="card-ph" aria-hidden="true"><span class="braille"><i></i><i class="off"></i><i class="off"></i><i></i><i></i><i class="off"></i></span></div>}
              <div class="card-body">
                <p class="pill">{formatDate(n.data.date, lang)}</p>
                <h3 class="card-title"><a href={localizedPath(lang, `news/${n.slug}`)}>{loc(n.data, 'title', lang)}</a></h3>
                <p>{loc(n.data, 'summary', lang)}</p>
                <p style="margin-top:auto;"><a href={localizedPath(lang, `news/${n.slug}`)} class="link-arrow">{t('btn.readMore')} <Icon name="arrow" size={16} /></a></p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="muted" style="margin-top:1rem;">{t('home.noNews')}</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero { padding-top: clamp(1.5rem, 3vw, 2.5rem); padding-bottom: clamp(3.5rem, 6vw, 5rem); }
  .hero-panel {
    position: relative;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    background: linear-gradient(145deg, var(--brand-darker) 0%, var(--brand-deep) 100%);
    border-radius: var(--radius-xl);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    overflow: hidden;
  }
  :global([data-contrast="high"]) .hero-panel { background: #001a2e; }
  .hero-text { color: #fff; }
  .hero-text h1 { color: #fff; margin-top: 0.4rem; }
  .eyebrow.light { color: var(--sky-200); }
  .eyebrow.light::before { background: var(--accent); }
  .hero-sub { color: #dcecf7; font-size: 1.2rem; line-height: 1.6; margin-top: 1rem; max-width: 46ch; }
  :global([data-contrast="high"]) .hero-sub { color: #fff; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.75rem; }

  .btn-white { background: #fff; color: var(--brand-darker); }
  .btn-white:hover { background: var(--sky-100); color: var(--brand-deep); }
  .btn-ghost-light { background: rgba(255,255,255,0.1); color: #fff; border-color: rgba(255,255,255,0.5); }
  .btn-ghost-light:hover { background: rgba(255,255,255,0.2); color: #fff; }

  .hero-photo { align-self: stretch; }
  .hero-photo img, .hero-ph {
    width: 100%; height: 100%; min-height: 320px;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .hero-ph {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.25rem;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.15);
  }
  .braille-lg { grid-template-columns: repeat(2, 1rem); gap: 0.55rem; }
  .braille-lg i { width: 1rem; height: 1rem; background: rgba(255,255,255,0.95); }
  .braille-lg i.off { background: rgba(255,255,255,0.3); }

  /* Overlapping stat cards */
  .stat-cards {
    position: relative;
    z-index: 2;
    margin: -2.75rem 0 0;
    padding-inline: clamp(0.5rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .stat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: 1.35rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .stat-icon { display: inline-grid; place-items: center; width: 50px; height: 50px; border-radius: 14px; background: var(--sky-100); color: var(--brand-darker); flex-shrink: 0; }
  .stat-card dd { font-family: var(--font-display); font-size: clamp(1.6rem, 3.5vw, 2.1rem); font-weight: 800; color: var(--brand-dark); margin: 0; line-height: 1; }
  .stat-card dt { color: var(--muted); font-weight: 500; font-size: 0.92rem; margin-top: 0.25rem; }

  /* ---------- About ---------- */
  .about-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .about-photos { position: relative; display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .about-img-main, .about-ph-main { width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow); aspect-ratio: 4/5; object-fit: cover; }
  .about-img-sub, .about-ph-sub {
    position: absolute; right: -1.25rem; bottom: -1.25rem;
    width: 48%; aspect-ratio: 1/1; border-radius: var(--radius-lg);
    object-fit: cover; border: 6px solid var(--bg); box-shadow: var(--shadow-lg);
  }
  .about-ph { display: grid; place-items: center; background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%); color: rgba(255,255,255,0.9); }
  .about-ph-sub { background: linear-gradient(135deg, var(--sky-200), var(--sky-100)); color: var(--brand-darker); }

  .vm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 0.5rem; }
  .vm { border-top: 3px solid var(--brand); padding-top: 0.9rem; }
  .vm h3 { font-size: 1.15rem; color: var(--brand-dark); }
  .vm p { font-size: 1rem; color: var(--ink-soft); }

  .link-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; text-decoration: none; color: var(--brand-dark); }
  .link-arrow:hover { text-decoration: underline; }

  /* ---------- Offer / CTA / News ---------- */
  .soft { background: var(--surface-2); }
  .feature-icon { display: inline-grid; place-items: center; width: 58px; height: 58px; border-radius: 16px; background: var(--sky-100); color: var(--brand-darker); margin-bottom: 0.4rem; }

  .cta-band { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%); color: #fff; padding-block: clamp(3rem, 6vw, 4.5rem); }
  :global([data-contrast="high"]) .cta-band { background: #001a2e; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-inner h2 { color: #fff; max-width: 20ch; }
  .cta-text { color: #e6f3fc; }
  :global([data-contrast="high"]) .cta-text { color: #fff; }
  .cta-btn { background: #fff; color: var(--brand-darker); flex-shrink: 0; }
  .cta-btn:hover { background: var(--sky-100); color: var(--brand-deep); }

  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .card-title { font-size: 1.3rem; }
  .card-title a { text-decoration: none; color: var(--ink); }
  .card-title a:hover { color: var(--brand-dark); text-decoration: underline; }
  .card-ph { aspect-ratio: 16/10; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky-100), var(--sky-200)); }

  @media (max-width: 900px) {
    .hero-panel { grid-template-columns: 1fr; }
    .hero-photo { order: -1; }
    .hero-photo img, .hero-ph { min-height: 240px; aspect-ratio: 16/10; }
    .stat-cards { grid-template-columns: 1fr; margin-top: 1.5rem; }
    .about-grid { grid-template-columns: 1fr; }
    .about-photos { max-width: 420px; }
    .vm-grid { grid-template-columns: 1fr; }
  }
</style>

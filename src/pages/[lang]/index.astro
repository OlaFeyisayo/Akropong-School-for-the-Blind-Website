---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath, loc, formatDate, toLang, type Lang } from '../../i18n/utils';
import { getAllNews } from '../../lib/news';
import home from '../../data/pages/home.json';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const lang: Lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const news = getAllNews().slice(0, 3);
---

<BaseLayout lang={lang} title={t('nav.home')}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-copy stack center">
      <p class="eyebrow">Akropong School for the Blind · Ghana</p>
      <h1>{loc(home, 'heroTitle', lang)}</h1>
      <p class="lead hero-lead">{loc(home, 'heroSubtitle', lang)}</p>
      <div class="hero-actions">
        <a href={localizedPath(lang, 'donate')} class="btn btn-accent">
          <Icon name="heart" size={20} /> {t('btn.donateNow')}
        </a>
        <a href={localizedPath(lang, 'about')} class="btn btn-outline">{t('btn.learnMore')}</a>
      </div>
    </div>

    <div class="container">
      <figure class="hero-media">
        {home.heroImage
          ? <img src={home.heroImage} alt={loc(home, 'heroImageAlt', lang)} width="1120" height="620" />
          : (
            <div class="hero-placeholder" aria-hidden="true">
              <span class="braille braille-lg">
                <i></i><i class="off"></i><i></i><i></i><i class="off"></i><i></i>
              </span>
              <Icon name="eye" size={64} />
            </div>
          )}
      </figure>
    </div>
  </section>

  <!-- Trust / stats strip -->
  {home.stats?.length > 0 && (
    <section class="stats-band">
      <div class="container">
        <dl class="stats">
          {home.stats.map((s) => (
            <div class="stat">
              <dd>{s.value}</dd>
              <dt>{loc(s, 'label', lang)}</dt>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <!-- Intro -->
  <section class="section">
    <div class="container intro-grid">
      <div class="stack">
        <p class="eyebrow">{loc(home, 'introEyebrow', lang)}</p>
        <h2>{loc(home, 'introTitle', lang)}</h2>
        <p class="lead">{loc(home, 'introText', lang)}</p>
        <p><a href={localizedPath(lang, 'about')} class="link-arrow">{t('btn.learnMore')} <Icon name="arrow" size={18} /></a></p>
      </div>
      <aside class="intro-aside" aria-hidden="true">
        <div class="quote-card">
          <span class="braille">
            <i></i><i class="off"></i><i></i><i></i><i></i><i class="off"></i>
          </span>
          <p class="quote-text">{lang === 'fr' ? '« Lire, c’est toucher la lumière du savoir. »' : '“To read is to touch the light of learning.”'}</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Highlights -->
  <section class="section soft">
    <div class="container">
      <div class="center stack" style="max-width: 46rem; margin-inline: auto;">
        <p class="eyebrow">{loc(home, 'introEyebrow', lang)}</p>
        <h2>{loc(home, 'highlightsTitle', lang)}</h2>
      </div>
      <div class="grid grid-3" style="margin-top: 3rem;">
        {home.highlights?.map((h) => (
          <article class="card feature">
            <div class="card-body">
              <span class="feature-icon" aria-hidden="true"><Icon name={h.icon} size={28} /></span>
              <h3>{loc(h, 'title', lang)}</h3>
              <p>{loc(h, 'text', lang)}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Donate CTA band -->
  <section class="cta-band">
    <div class="container cta-inner">
      <div class="stack">
        <h2>{loc(home, 'ctaTitle', lang)}</h2>
        <p class="lead cta-text">{loc(home, 'ctaText', lang)}</p>
      </div>
      <a href={localizedPath(lang, 'donate')} class="btn cta-btn">
        <Icon name="gift" size={20} /> {t('btn.donateNow')}
      </a>
    </div>
  </section>

  <!-- Latest news -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{t('nav.news')}</p>
          <h2>{t('home.latestNews')}</h2>
        </div>
        <a href={localizedPath(lang, 'news')} class="link-arrow">{t('btn.allNews')} <Icon name="arrow" size={18} /></a>
      </div>
      {news.length > 0 ? (
        <div class="grid grid-3" style="margin-top: 2.5rem;">
          {news.map((n) => (
            <article class="card">
              {n.data.image
                ? <img src={n.data.image} alt={loc(n.data, 'imageAlt', lang)} width="400" height="250" />
                : <div class="card-ph" aria-hidden="true"><span class="braille"><i></i><i class="off"></i><i class="off"></i><i></i><i></i><i class="off"></i></span></div>}
              <div class="card-body">
                <p class="pill">{formatDate(n.data.date, lang)}</p>
                <h3 class="card-title"><a href={localizedPath(lang, `news/${n.slug}`)}>{loc(n.data, 'title', lang)}</a></h3>
                <p>{loc(n.data, 'summary', lang)}</p>
                <p style="margin-top:auto;"><a href={localizedPath(lang, `news/${n.slug}`)} class="link-arrow">{t('btn.readMore')} <Icon name="arrow" size={16} /></a></p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="muted" style="margin-top:1rem;">{t('home.noNews')}</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    background:
      radial-gradient(60% 50% at 50% 0%, var(--sky-100) 0%, transparent 70%),
      var(--bg);
  }
  .hero-copy { max-width: 52rem; margin-inline: auto; }
  .hero-lead { font-size: 1.3rem; max-width: 42rem; margin-inline: auto; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: 0.75rem; }

  .hero-media { margin: clamp(2rem, 5vw, 3.5rem) 0 0; }
  .hero-media img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    aspect-ratio: 16 / 8;
    object-fit: cover;
    border: 6px solid var(--surface);
    outline: 1px solid var(--border);
  }
  .hero-placeholder {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem;
    aspect-ratio: 16 / 7;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
    color: rgba(255,255,255,0.92);
    box-shadow: var(--shadow-lg);
  }
  .braille-lg { grid-template-columns: repeat(2, 1.1rem); gap: 0.6rem; }
  .braille-lg i { width: 1.1rem; height: 1.1rem; background: rgba(255,255,255,0.95); }
  .braille-lg i.off { background: rgba(255,255,255,0.3); }

  /* Stats */
  .stats-band { background: var(--brand-deep); color: #fff; }
  :global([data-contrast="high"]) .stats-band { background: #001a2e; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; padding-block: clamp(2rem, 4vw, 2.75rem); text-align: center; margin: 0; }
  .stat { display: flex; flex-direction: column; gap: 0.2rem; }
  .stat dd { font-family: var(--font-serif); font-size: clamp(2rem, 5vw, 3rem); font-weight: 600; color: #fff; margin: 0; }
  .stat dt { color: var(--sky-200); font-weight: 500; font-size: 0.98rem; }
  :global([data-contrast="high"]) .stat dt { color: #fff; }
  .stat + .stat { border-left: 1px solid rgba(255,255,255,0.15); }

  /* Intro */
  .intro-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: clamp(2rem, 5vw, 4rem); align-items: center; }
  .quote-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow);
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  .quote-text { font-family: var(--font-serif); font-size: 1.5rem; font-style: italic; color: var(--brand-darker); line-height: 1.35; }

  .link-arrow { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; text-decoration: none; color: var(--brand-dark); }
  .link-arrow:hover { text-decoration: underline; }

  .soft { background: var(--surface-2); }

  .feature-icon { display: inline-grid; place-items: center; width: 58px; height: 58px; border-radius: 16px; background: var(--sky-100); color: var(--brand-darker); margin-bottom: 0.4rem; }

  .cta-band { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%); color: #fff; padding-block: clamp(3rem, 6vw, 4.5rem); }
  :global([data-contrast="high"]) .cta-band { background: #001a2e; }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .cta-inner h2 { color: #fff; max-width: 20ch; }
  .cta-text { color: #e6f3fc; }
  :global([data-contrast="high"]) .cta-text { color: #fff; }
  .cta-btn { background: #fff; color: var(--brand-darker); flex-shrink: 0; }
  .cta-btn:hover { background: var(--sky-100); color: var(--brand-deep); }

  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .card-title { font-size: 1.3rem; }
  .card-title a { text-decoration: none; color: var(--ink); }
  .card-title a:hover { color: var(--brand-dark); text-decoration: underline; }
  .card-ph { aspect-ratio: 16/10; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky-100), var(--sky-200)); }

  @media (max-width: 860px) {
    .intro-grid { grid-template-columns: 1fr; }
    .stats { grid-template-columns: 1fr; gap: 1.5rem; }
    .stat + .stat { border-left: 0; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 1.5rem; }
    .hero-media img { aspect-ratio: 4/3; }
  }
</style>

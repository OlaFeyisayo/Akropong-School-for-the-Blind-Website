---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, loc, toLang, type Lang } from '../../i18n/utils';
import contact from '../../data/pages/contact.json';
import settings from '../../data/settings.json';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}
const lang: Lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const socials = [
  { url: settings.facebook, label: 'Facebook' },
  { url: settings.instagram, label: 'Instagram' },
  { url: settings.youtube, label: 'YouTube' },
  { url: settings.x, label: 'X' },
  { url: settings.linkedin, label: 'LinkedIn' },
].filter((s) => s.url);

const L = (en: string, fr: string) => (lang === 'fr' ? fr : en);
---

<BaseLayout lang={lang} title={loc(contact, 'title', lang)}>
  <PageHeader title={loc(contact, 'title', lang)} intro={loc(contact, 'intro', lang)} />

  <section class="section">
    <div class="container contact-grid">
      <!-- Contact details -->
      <div class="stack">
        <h2>{t('contact.reach')}</h2>
        <ul class="contact-list">
          {settings.email && (
            <li>
              <span class="ci" aria-hidden="true"><Icon name="mail" size={22} /></span>
              <span><strong>{t('contact.email')}</strong><br /><a href={`mailto:${settings.email}`}>{settings.email}</a></span>
            </li>
          )}
          {settings.phone && (
            <li>
              <span class="ci" aria-hidden="true"><Icon name="phone" size={22} /></span>
              <span><strong>{t('contact.phone')}</strong><br /><a href={`tel:${settings.phone.replace(/\s+/g, '')}`}>{settings.phone}</a></span>
            </li>
          )}
          {loc(settings, 'address', lang) && (
            <li>
              <span class="ci" aria-hidden="true"><Icon name="pin" size={22} /></span>
              <span><strong>{t('contact.address')}</strong><br />{loc(settings, 'address', lang)}</span>
            </li>
          )}
        </ul>

        {loc(contact, 'hoursBody', lang) && (
          <div class="hours">
            <h3>{loc(contact, 'hoursTitle', lang)}</h3>
            <p>{loc(contact, 'hoursBody', lang)}</p>
          </div>
        )}

        {socials.length > 0 && (
          <div>
            <h3>{t('contact.follow')}</h3>
            <ul class="socials">
              {socials.map((s) => (
                <li><a href={s.url} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">{s.label}<span class="sr-only"> ({L('opens in a new tab', 'nouvel onglet')})</span></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Contact form (handled by Netlify Forms once deployed) -->
      <div class="form-wrap">
        <h2>{L('Send us a message', 'Envoyez-nous un message')}</h2>
        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="contact-form">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden-field">
            <label>{L("Don't fill this in", 'Ne remplissez pas ceci')}: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="field">
            <label for="name">{L('Your name', 'Votre nom')} <span class="req" aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>
          <div class="field">
            <label for="email">{L('Your email', 'Votre e-mail')} <span class="req" aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" required autocomplete="email" />
          </div>
          <div class="field">
            <label for="message">{L('Message', 'Message')} <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">{L('Send message', 'Envoyer le message')}</button>
          <p class="form-note muted">{L('* Required fields. We will reply by email.', '* Champs obligatoires. Nous répondrons par e-mail.')}</p>
        </form>
      </div>
    </div>
  </section>

  {settings.mapEmbedUrl && (
    <section class="section-tight">
      <div class="container">
        <h2 class="sr-only">{L('Map', 'Carte')}</h2>
        <div class="map-wrap">
          <iframe
            src={settings.mapEmbedUrl}
            title={L('Map showing the location of the school', "Carte indiquant l'emplacement de l'école")}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .contact-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .contact-list li { display: flex; gap: 0.9rem; align-items: flex-start; }
  .ci { display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--surface-2); color: var(--brand-dark); flex-shrink: 0; }
  .hours h3, .socials + h3 { color: var(--brand-dark); }
  .socials { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }

  .form-wrap { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: var(--shadow); }
  .contact-form { display: grid; gap: 1.1rem; margin-top: 1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-weight: 700; }
  .req { color: var(--accent-dark); }
  input, textarea {
    font: inherit; width: 100%;
    padding: 0.7rem 0.85rem;
    border: 2px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--ink);
  }
  input:focus, textarea:focus { border-color: var(--brand); outline: 3px solid var(--ring); outline-offset: 1px; }
  textarea { resize: vertical; }
  .hidden-field { position: absolute; left: -9999px; }
  .form-note { font-size: 0.9rem; }

  .map-wrap { border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border); box-shadow: var(--shadow); }
  .map-wrap iframe { width: 100%; height: 380px; border: 0; display: block; }

  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
</style>

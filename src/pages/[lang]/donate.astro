---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Markdown from '../../components/Markdown.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations, localizedPath, loc, toLang, type Lang } from '../../i18n/utils';
import donate from '../../data/pages/donate.json';
import settings from '../../data/settings.json';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}
const lang: Lang = toLang(Astro.params.lang);
const t = useTranslations(lang);

const hasOnline = !!settings.donateUrl;
const hasMomo = !!settings.momoNumber;
const hasBank = !!settings.bankAccountNumber || !!settings.bankName;
const hasAnyMethod = hasOnline || hasMomo || hasBank;
---

<BaseLayout lang={lang} title={loc(donate, 'title', lang)}>
  <PageHeader title={loc(donate, 'title', lang)} intro={loc(donate, 'intro', lang)} />

  <!-- Impact tiers -->
  {donate.impact?.length > 0 && (
    <section class="section-tight">
      <div class="container">
        <div class="grid grid-3">
          {donate.impact.map((i) => (
            <div class="impact card">
              <div class="card-body">
                <span class="feature-icon" aria-hidden="true"><Icon name="gift" size={28} /></span>
                <p class="impact-amount">{loc(i, 'amount', lang)}</p>
                <p>{loc(i, 'text', lang)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Ways to give -->
  <section class="section" style="background: var(--surface-2);">
    <div class="container">
      <h2 class="center">{t('donate.give')}</h2>

      {hasAnyMethod ? (
        <div class="give-grid" style="margin-top: 2rem;">
          {hasOnline && (
            <div class="give card">
              <div class="card-body">
                <h3><Icon name="heart" size={22} /> {t('donate.online')}</h3>
                <p>{lang === 'fr' ? 'Faites un don sécurisé en ligne en quelques minutes.' : 'Make a secure gift online in just a few minutes.'}</p>
                <p style="margin-top:auto;"><a href={settings.donateUrl} class="btn btn-accent" target="_blank" rel="noopener noreferrer">{t('btn.donateNow')}</a></p>
              </div>
            </div>
          )}

          {hasMomo && (
            <div class="give card">
              <div class="card-body">
                <h3><Icon name="phone" size={22} /> {t('donate.mobileMoney')}</h3>
                <dl class="pay-details">
                  <div><dt>{lang === 'fr' ? 'Numéro' : 'Number'}</dt><dd>{settings.momoNumber}</dd></div>
                  {settings.momoName && <div><dt>{lang === 'fr' ? 'Nom' : 'Name'}</dt><dd>{settings.momoName}</dd></div>}
                </dl>
              </div>
            </div>
          )}

          {hasBank && (
            <div class="give card">
              <div class="card-body">
                <h3><Icon name="book" size={22} /> {t('donate.bank')}</h3>
                <dl class="pay-details">
                  {settings.bankName && <div><dt>{t('donate.bankName')}</dt><dd>{settings.bankName}</dd></div>}
                  {settings.bankAccountName && <div><dt>{lang === 'fr' ? 'Titulaire' : 'Account name'}</dt><dd>{settings.bankAccountName}</dd></div>}
                  {settings.bankAccountNumber && <div><dt>{t('donate.accountNumber')}</dt><dd>{settings.bankAccountNumber}</dd></div>}
                  {settings.bankBranch && <div><dt>{lang === 'fr' ? 'Agence' : 'Branch'}</dt><dd>{settings.bankBranch}</dd></div>}
                  {settings.bankSwift && <div><dt>SWIFT/BIC</dt><dd>{settings.bankSwift}</dd></div>}
                </dl>
              </div>
            </div>
          )}
        </div>
      ) : (
        <div class="notice" role="note">
          <p>{lang === 'fr'
            ? "Les coordonnées de don (lien en ligne, Mobile Money, virement bancaire) seront ajoutées ici prochainement. En attendant, contactez-nous pour savoir comment soutenir l'école."
            : 'Donation details (online link, Mobile Money, bank transfer) will be added here soon. In the meantime, please contact us to learn how to support the school.'}</p>
          <p><a href={localizedPath(lang, 'contact')} class="btn btn-primary">{t('nav.contact')}</a></p>
        </div>
      )}

      <p class="give-note">{loc(donate, 'note', lang)}</p>
    </div>
  </section>

  <!-- Other ways to help -->
  <section class="section">
    <div class="container give-help">
      <h2>{loc(donate, 'waysTitle', lang)}</h2>
      <Markdown text={loc(donate, 'waysBody', lang)} />
      <p style="margin-top:1rem;"><a href={localizedPath(lang, 'contact')} class="link-arrow">{t('btn.getInvolved')} <Icon name="arrow" size={18} /></a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .feature-icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--surface-2); color: var(--brand-dark); margin-bottom: 0.3rem; }
  .impact-amount { font-weight: 800; font-size: 1.2rem; color: var(--brand-dark); }
  .give-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .give h3 { display: flex; align-items: center; gap: 0.5rem; color: var(--brand-dark); }
  .give h3 :global(svg) { color: var(--accent); }
  .pay-details { display: grid; gap: 0.6rem; margin-top: 0.3rem; }
  .pay-details div { display: flex; flex-direction: column; }
  .pay-details dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); font-weight: 700; }
  .pay-details dd { font-weight: 700; font-size: 1.05rem; }
  .notice { max-width: 46rem; margin: 2rem auto 0; background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: var(--radius); padding: 1.5rem; }
  .notice p + p { margin-top: 1rem; }
  .give-note { text-align: center; color: var(--muted); margin-top: 2rem; max-width: none; }
  .give-help { max-width: 50rem; }
  .link-arrow { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 700; text-decoration: none; }
  .link-arrow:hover { text-decoration: underline; }
</style>

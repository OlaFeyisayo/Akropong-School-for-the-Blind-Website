---
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';
import settings from '../data/settings.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const currentPath = Astro.url.pathname;
const rest = currentPath.replace(/^\/(en|fr)\/?/, '');
const otherLang: Lang = lang === 'en' ? 'fr' : 'en';
const altPath = `/${otherLang}/${rest}`;

const nav = [
  { href: localizedPath(lang, ''), key: 'nav.home' as const },
  { href: localizedPath(lang, 'about'), key: 'nav.about' as const },
  { href: localizedPath(lang, 'programs'), key: 'nav.programs' as const },
  { href: localizedPath(lang, 'news'), key: 'nav.news' as const },
  { href: localizedPath(lang, 'contact'), key: 'nav.contact' as const },
];

const homePath = localizedPath(lang, '');
const donatePath = localizedPath(lang, 'donate');

function isActive(href: string): boolean {
  if (href === homePath) return currentPath === homePath;
  return currentPath.startsWith(href);
}
---

<!-- Accessibility & language utility bar -->
<div class="util-bar">
  <div class="container util-inner">
    <div class="a11y" role="group" aria-label={t('a11y.toolbar')}>
      <span class="a11y-label" aria-hidden="true">{t('a11y.textSize')}:</span>
      <button type="button" class="a11y-btn ts" data-size="" aria-label={t('a11y.textNormal')} aria-pressed="true"><span style="font-size:.8rem">A</span></button>
      <button type="button" class="a11y-btn ts" data-size="large" aria-label={t('a11y.textLarge')} aria-pressed="false"><span style="font-size:1rem">A</span></button>
      <button type="button" class="a11y-btn ts" data-size="xlarge" aria-label={t('a11y.textXLarge')} aria-pressed="false"><span style="font-size:1.25rem">A</span></button>
      <button type="button" class="a11y-btn contrast-btn" aria-label={t('a11y.contrastOn')} aria-pressed="false">
        <span aria-hidden="true">◐</span>
        <span class="a11y-btn-text">{t('a11y.contrast')}</span>
      </button>
    </div>

    <div class="lang" role="group" aria-label={t('a11y.language')}>
      <a href={lang === 'en' ? currentPath : altPath} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined} class={lang === 'en' ? 'lang-link active' : 'lang-link'}>EN</a>
      <span aria-hidden="true" class="lang-sep">|</span>
      <a href={lang === 'fr' ? currentPath : altPath} hreflang="fr" lang="fr" aria-current={lang === 'fr' ? 'true' : undefined} class={lang === 'fr' ? 'lang-link active' : 'lang-link'}>FR</a>
    </div>
  </div>
</div>

<header class="site-header">
  <div class="container header-inner">
    <a href={homePath} class="brand" aria-label={settings.orgName}>
      {settings.logo
        ? <img src={settings.logo} alt="" width="44" height="44" class="brand-logo" />
        : <span class="brand-mark" aria-hidden="true">⠁</span>}
      <span class="brand-text">
        <span class="brand-name">Akropong</span>
        <span class="brand-sub">{lang === 'fr' ? 'École pour les Aveugles' : 'School for the Blind'}</span>
      </span>
    </a>

    <button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label={t('a11y.openMenu')}>
      <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class={isActive(item.href) ? 'active' : ''}>
              {t(item.key)}
            </a>
          </li>
        ))}
        <li class="nav-donate">
          <a href={donatePath} class="btn btn-accent">{t('nav.donate')}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .util-bar {
    background: var(--ink);
    color: #fff;
    font-size: 0.85rem;
  }
  :global([data-theme="dark"]) .util-bar,
  :global([data-contrast="high"]) .util-bar { background: #000; }
  .util-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 44px;
    flex-wrap: wrap;
    padding-block: 0.25rem;
  }
  .a11y { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .a11y-label { opacity: 0.85; margin-right: 0.15rem; }
  .a11y-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    min-width: 36px;
    min-height: 36px;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    line-height: 1;
  }
  .a11y-btn:hover { background: rgba(255, 255, 255, 0.24); }
  .a11y-btn[aria-pressed="true"] { background: var(--accent); color: #241400; border-color: var(--accent); }
  .contrast-btn { padding-inline: 0.65rem; }
  .a11y-btn-text { font-size: 0.8rem; }

  .lang { display: flex; align-items: center; gap: 0.5rem; }
  .lang-link {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 0.3rem 0.5rem;
    border-radius: 6px;
    min-width: 36px;
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .lang-link:hover { background: rgba(255, 255, 255, 0.18); color: #fff; }
  .lang-link.active { background: var(--accent); color: #241400; }
  .lang-sep { opacity: 0.5; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 2px 10px rgba(16, 36, 31, 0.05);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 74px;
  }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: var(--ink); }
  .brand-logo { border-radius: 10px; object-fit: contain; }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; height: 44px;
    background: var(--brand);
    color: #fff;
    border-radius: 12px;
    font-size: 1.6rem;
    line-height: 1;
  }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name { font-weight: 800; font-size: 1.25rem; letter-spacing: -0.02em; }
  .brand-sub { font-size: 0.78rem; color: var(--muted); font-weight: 600; }

  .primary-nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0; padding: 0;
  }
  .primary-nav a:not(.btn) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
  }
  .primary-nav a:not(.btn):hover { background: var(--surface-2); color: var(--brand-dark); }
  .primary-nav a.active { color: var(--brand-dark); background: var(--surface-2); }
  .nav-donate { margin-left: 0.4rem; }

  .menu-toggle {
    display: none;
    width: 48px; height: 48px;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 10px;
    cursor: pointer;
    align-items: center;
    justify-content: center;
  }
  .menu-bars { display: inline-flex; flex-direction: column; gap: 5px; }
  .menu-bars span {
    display: block; width: 24px; height: 3px;
    background: var(--ink); border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] .menu-bars span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  @media (max-width: 860px) {
    .menu-toggle { display: inline-flex; }
    .primary-nav {
      position: absolute;
      left: 0; right: 0; top: 100%;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
      display: none;
      padding: 0.75rem var(--space) 1.25rem;
    }
    .primary-nav.open { display: block; }
    .primary-nav ul { flex-direction: column; align-items: stretch; gap: 0.25rem; }
    .primary-nav a:not(.btn) { min-height: 50px; }
    .nav-donate { margin: 0.5rem 0 0; }
    .nav-donate .btn { width: 100%; }
    .a11y-btn-text { display: none; }
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;

    // Mobile menu
    var toggle = document.getElementById('menu-toggle');
    var navEl = document.getElementById('primary-nav');
    if (toggle && navEl) {
      toggle.addEventListener('click', function () {
        var open = navEl.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // Text size buttons
    var tsButtons = document.querySelectorAll('.a11y-btn.ts');
    function syncTextButtons() {
      var current = root.getAttribute('data-textsize') || '';
      tsButtons.forEach(function (b) {
        b.setAttribute('aria-pressed', (b.getAttribute('data-size') || '') === current ? 'true' : 'false');
      });
    }
    tsButtons.forEach(function (b) {
      b.addEventListener('click', function () {
        var size = b.getAttribute('data-size') || '';
        if (size) { root.setAttribute('data-textsize', size); } else { root.removeAttribute('data-textsize'); }
        try { localStorage.setItem('a11y-textsize', size); } catch (e) {}
        syncTextButtons();
      });
    });
    syncTextButtons();

    // High-contrast toggle
    var cbtn = document.querySelector('.contrast-btn');
    if (cbtn) {
      function syncContrast() {
        var on = root.getAttribute('data-contrast') === 'high';
        cbtn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      cbtn.addEventListener('click', function () {
        var on = root.getAttribute('data-contrast') === 'high';
        if (on) { root.removeAttribute('data-contrast'); } else { root.setAttribute('data-contrast', 'high'); }
        try { localStorage.setItem('a11y-contrast', on ? '' : 'high'); } catch (e) {}
        syncContrast();
      });
      syncContrast();
    }
  })();
</script>
